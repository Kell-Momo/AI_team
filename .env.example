# Copy to .env and fill in. Never commit .env.

# --- Zetaris (data layer, REST) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=your-org-id
# Read-only NON-ADMIN user's API key.
ZETARIS_API_KEY=your-non-admin-api-key
ZETARIS_USL=lightning.metastore.growthloop.marketing
# Admin key: only for the one-off `npm run zetaris:setup`. Leave unset otherwise.
# ZETARIS_ADMIN_API_KEY=your-admin-api-key

# --- Meterless Nightshift (AI provider, OpenAI-compatible) ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-runtime-token
METERLESS_MODEL=meterless/auto

# --- App ---
# true = judge/offline mode: real agent logic on local CSVs, without Zetaris/Nightshift.
SAMPLE_MODE=false
# 3000 is taken by the Zetaris UI.
PORT=8000
# debug | info | warn | error (stdout only; the JSONL trace always records everything)
LOG_LEVEL=info
